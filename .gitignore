# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
.vite/
.turbo/

# Local data and runtime artifacts
data/
config/sender.local.json

# Secrets
.env
.env.*
!.env.example

# Test output
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Reference material. Never committed: the recording is of someone's own
# browser session and contains personal account details.
#
# Case-insensitive, optional plural, anchored at the root, so ref/, Ref/, refs/
# and Refs/ are all excluded. Two traps here, both hit in practice: git is
# case-sensitive by default, and `[Rr]efs?/` does NOT work, because `?` matches
# the trailing slash and leaves the pattern's own `/` with nothing to match.
/[Rr]ef*/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
# E2E artefacts. Screenshots and traces are regenerated per run and are not part
# of the source; the report is a local convenience.
apps/web/test-results/
apps/web/playwright-report/
