{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@localscout/core": ["../../packages/core/src/index.ts"]
    }
  },
  // The e2e suite is included so `pnpm typecheck` covers it. Playwright types
  // are listed explicitly because this project does not use the global `types`
  // convention; the specs import from `@playwright/test` rather than relying on
  // ambient globals, so only the driver types are needed.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
