# Discovery
# fixtures = recorded local data, no key, works offline.
# live     = SerpApi Google Maps engine, needs SERPAPI_API_KEY.
DISCOVERY_MODE=fixtures
SERPAPI_API_KEY=
SERPAPI_CACHE_DIR=./data/cache/serpapi

# LLM
# fixture            = canned drafts for tests and CI.
# ollama             = local open-weight model, no key.
# openai-compatible  = any /v1/chat/completions endpoint, needs LLM_API_KEY.
LLM_PROVIDER=fixture
LLM_BASE_URL=http://127.0.0.1:11434
# Check what you have pulled with: ollama list
LLM_MODEL=gemma3:4b
LLM_API_KEY=
LLM_TIMEOUT_MS=60000

# Audit
# Leave empty to auto-detect Chrome or Chromium.
CHROME_PATH=
AUDIT_CONCURRENCY=2
AUDIT_TIMEOUT_MS=120000

# App
DEFAULT_COUNTRY=IN
DATA_DIR=./data
API_PORT=8787
LOG_LEVEL=info

# Deployment (optional). The defaults above are local: the API binds 127.0.0.1
# and nothing is reachable from another machine.
# HOST: set to 0.0.0.0 only behind a platform that terminates TLS for you.
# A non-loopback HOST is refused unless AUTH_TOKEN is set, and the token then
# gates every route. 16+ characters: openssl rand -hex 32
HOST=127.0.0.1
AUTH_TOKEN=
# PORT is assigned by most hosting platforms and is used only when API_PORT
# is unset. Leave empty locally.
PORT=

# Sender profile
# These are the fallback. The Settings screen writes config/sender.local.json
# (git-ignored), which wins over these values.
SENDER_NAME=
SENDER_PORTFOLIO_URL=
SENDER_SERVICES=website redesign, mobile-friendly sites, speed fixes

# Scheduled saved searches, off by default.
SCHEDULER_ENABLED=false