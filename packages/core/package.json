{
  "name": "@localscout/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure, tested domain logic for Localscout: config, db, discovery, audit, draft, scoring.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.15",
    "node-html-parser": "^9.0.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
